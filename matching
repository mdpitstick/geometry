<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Math Matching Activity</title>

<style>

*{
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f5f7fb;
    padding:20px;
    margin:0;
}

h1{
    text-align:center;
    margin-bottom:20px;
}

.progress-container{
    width:80%;
    max-width:800px;
    margin:0 auto;
    background:#ddd;
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    width:0%;
    height:30px;
    background:#4CAF50;
    transition:width .3s;
}

.progress-text{
    text-align:center;
    margin:10px 0 20px;
    font-weight:bold;
}

#resetBtn{
    display:block;
    margin:0 auto 25px;
    padding:10px 20px;
    border:none;
    border-radius:8px;
    background:#1976d2;
    color:white;
    font-size:1rem;
    font-weight:bold;
    cursor:pointer;
}

#resetBtn:hover{
    background:#1565c0;
}

#matchingBoard{
    max-width:1100px;
    margin:0 auto;
}

.match-row{
    display:grid;
    grid-template-columns:280px 1fr;
    gap:20px;
    margin-bottom:12px;
    align-items:center;
}

.problem,
.answer{
    min-height:70px;
    border-radius:10px;
    padding:15px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    font-weight:bold;
}

.problem{
    background:#1976d2;
    color:white;
    cursor:grab;
    touch-action:none;
    user-select:none;
}

.answer{
    background:white;
    border:3px dashed #999;
}

.dragging{
    opacity:.85;
}

.correct{
    background:#4CAF50 !important;
    color:white !important;
    border:none !important;
}

.pair{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    width:100%;
    font-size:1.1rem;
}

#message{
    text-align:center;
    margin-top:25px;
    font-size:1.6rem;
    font-weight:bold;
    color:#4CAF50;
}

@media(max-width:700px){

    .match-row{
        grid-template-columns:1fr;
    }

}

</style>
</head>
<body>

<h1>Math Matching Activity</h1>

<div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
</div>

<div class="progress-text" id="progressText">
    0% Complete
</div>

<button id="resetBtn">Reset Activity</button>

<div id="matchingBoard"></div>

<div id="message"></div>

<script>

// ========================================
// EDIT ONLY THIS SECTION
// ========================================

const pairs = [
    ["2 + 3", "5"],
    ["8 - 2", "6"],
    ["21 ÷ 3", "7"],
    ["16 ÷ 2", "8"],
    ["3 × 3", "9"],
    ["15 - 5", "10"],
    ["20 - 9", "11"],
    ["5 + 7", "12"],
    ["7 + 8", "15"],
    ["4 × 4", "16"]
];

// ========================================

let matched = 0;
let activeCard = null;
let startX = 0;
let startY = 0;

function shuffle(array){

    for(let i=array.length-1;i>0;i--){

        const j=Math.floor(Math.random()*(i+1));

        [array[i],array[j]] =
        [array[j],array[i]];
    }

    return array;
}

function buildBoard(){

    matched = 0;

    document.getElementById("message").textContent = "";
    document.getElementById("progressBar").style.width = "0%";
    document.getElementById("progressText").textContent = "0% Complete";

    const board =
        document.getElementById("matchingBoard");

    board.innerHTML = "";

    const problems =
        shuffle([...pairs]);

    const answers =
        shuffle(
            pairs.map(pair => pair[1])
        );

    problems.forEach((pair,index)=>{

        const row =
            document.createElement("div");

        row.className =
            "match-row";

        const problem =
            document.createElement("div");

        problem.className =
            "problem";

        problem.textContent =
            pair[0];

        problem.dataset.answer =
            pair[1];

        const answer =
            document.createElement("div");

        answer.className =
            "answer target";

        answer.textContent =
            answers[index];

        answer.dataset.answer =
            answers[index];

        row.appendChild(problem);
        row.appendChild(answer);

        board.appendChild(row);

    });

    initializeDragging();
}

function initializeDragging(){

    document
    .querySelectorAll(".problem")
    .forEach(card=>{

        card.addEventListener(
            "pointerdown",
            startDrag
        );

    });
}

function startDrag(e){

    if(e.target.classList.contains("correct"))
        return;

    activeCard = e.target;

    startX = e.clientX;
    startY = e.clientY;

    activeCard.classList.add("dragging");

    activeCard.setPointerCapture(
        e.pointerId
    );

    activeCard.addEventListener(
        "pointermove",
        dragMove
    );

    activeCard.addEventListener(
        "pointerup",
        endDrag
    );
}

function dragMove(e){

    if(!activeCard) return;

    const dx =
        e.clientX - startX;

    const dy =
        e.clientY - startY;

    activeCard.style.transform =
        `translate(${dx}px,${dy}px)`;
}

function endDrag(){

    if(!activeCard) return;

    let matchedCorrectly = false;

    document
    .querySelectorAll(".target")
    .forEach(target=>{

        if(target.classList.contains("correct"))
            return;

        const cardRect =
            activeCard.getBoundingClientRect();

        const targetRect =
            target.getBoundingClientRect();

        const overlap =
            !(cardRect.right < targetRect.left ||
              cardRect.left > targetRect.right ||
              cardRect.bottom < targetRect.top ||
              cardRect.top > targetRect.bottom);

        if(overlap){

            if(
                activeCard.dataset.answer ===
                target.dataset.answer
            ){

                matchedCorrectly = true;

                snapMatch(
                    activeCard,
                    target
                );
            }
        }
    });

    if(!matchedCorrectly){

        activeCard.style.transition =
            "transform .25s";

        activeCard.style.transform =
            "translate(0px,0px)";

        const card = activeCard;

        setTimeout(()=>{
            card.style.transition = "";
        },250);
    }

    if(activeCard){

        activeCard.classList.remove(
            "dragging"
        );

        activeCard = null;
    }

}

function snapMatch(card,target){

    matched++;

    target.classList.add("correct");

    target.innerHTML = `
        <div class="pair">
            <span>✓</span>
            <span>${card.textContent}</span>
            <span>=</span>
            <span>${target.dataset.answer}</span>
        </div>
    `;

    card.remove();

    updateProgress();

    if(matched === pairs.length){

        document.getElementById("message")
            .textContent =
            "🎉 Activity Complete!";
    }
}

function updateProgress(){

    const percent =
        Math.round(
            (matched / pairs.length) * 100
        );

    document.getElementById("progressBar")
        .style.width = percent + "%";

    document.getElementById("progressText")
        .textContent =
        percent + "% Complete";
}

document
.getElementById("resetBtn")
.addEventListener(
    "click",
    buildBoard
);

buildBoard();

</script>

</body>
</html>
